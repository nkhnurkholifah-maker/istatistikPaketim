data=data.frame(y=c(6,9,12,5,13,2),x1=c(3,6,4,8,3,2),x2=c(9,13,3,2,4,4),x3=c(16,13,17,10,9,7))#
print(data)#
X=as.matrix(cbind(1,data$x1,data$x2,data$x3))#
print(X)#
XtX=t(X)%*%X#
print(XtX)#
Y=as.matrix(data$y)#
Xty=t(X)%*%Y#
print(Xty)#
i_XtX=solve(XtX)#
print(i_XtX)#
beta=i_XtX%*%Xty#
print(beta)#
