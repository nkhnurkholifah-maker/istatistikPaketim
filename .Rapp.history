print "hallo world"
library(rdd)
library(MASS)
library(RDD)
mp<- function(x,eps=1e-006)#
{#
	x<-as.matrix(x)#
	xsvd<-svd(x)#
	diago<-xsvd$d[xsvd$d>eps]#
	if(length(diago)==1)#
	{#
	xplus<-as.matrix(xsvd$v[,1])%*%t(as.matrix(xsvd$u[,1])/diago)#
	}#
	else#
	{#
xplus<-xsvd$v[,1:length(diago)]%*%diag(1/diago)%*%t(xsvd$u[,1:length(diago)])	#
	}#
	return(xplus)#
}#
trun<-function(prediktor,knot,orde)#
{#
	prediktor[prediktor<knot]<-knot#
	b<-(prediktor-knot)^orde#
	return(b)#
}#
selangkepercayaan<-function(data)#
{#
cat("\t    PROGRAM SELANG KEPERCAYAAN KURVA REGRESI SEMIPARAMETRIK\n\t BERDASARKAN ESTIMATOR SPLINE TRUNCATED PADA DATA LONGITUDINAL\n")#
cat("**********************************************************************************\n")#
	x<-data[,1]#
	t<-data[,2]#
	y<-data[,3]#
	M<-length(y)#
	p<-as.numeric(readline("Input orde : "))#
	k<-as.numeric(readline("Input jumlah knot optimum : "))#
	w<-rep(0,k)#
	for(i in 1:k)#
	{#
		cat("Input titik knot optimum  ke-",i)#
		w[i]<-as.numeric(readline(" = "))#
	}#
	#MENGHITUNG JUMLAH SUBJEK#
	n=0#
	for(i in 1:M)#
	{#
		if(data[i,2]==0)#
		{#
			i=1#
			n=n+i#
		}#
	}#
	cat("Jumlah Subjek : ",n,"\n")#
	#MENGHITUNG JUMLAH PENGAMATAN SETIAP SUBYEK#
	sp<-rep(0,(n+1))#
	sp[1]<-0#
	jp<-rep(0,n)#
	for(i in 2:n)#
	{#
		s<-sp[i-1]+1#
		repeat#
		{#
			s<-s+1#
			if(t[s]<t[s-1])break#
			g<-s#
		}#
		sp[i]<-g#
		jp[i-1]<-sp[i]-sp[i-1]#
	}#
	jp[n]<-M-sum(jp[1:(n-1)])#
	cat("=================================\nsubjek ke-\tjumlah pengamatan\n=================================\n")#
	for( i in 1:n)#
	cat(i,"\t\t", jp[i],"\n")#
	v1<-matrix(0,M,p)#
	for(i in 1:p)#
		{	#
			v1[,i]<-t^(i)#
		}#
	v2<-matrix(0,M,k)#
	for(j in 1:k)#
		{#
			v2[,j]<-trun(t,w[j],p)#
		}#
	T=cbind(v1,v2)#
	x1=rep(1,M)#
	X=cbind(x1,x)#
	C=cbind(X,T)#
	ER<-matrix(0,M,1)#
	c<-rep(0,(M+1))#
	c[1]<-0#
	for(i in 1:n)#
	{#
		c[i+1]<-sum(jp[1:i])#
		ER[(c[i]+1):c[i+1],1]<-rep(i,jp[i])#
	}#
	vr=rep(0,n)#
	z=1#
	for(i in 1:n)#
	{	#
		zt=z+jp[i]-1#
		vr[i]=var(data[(z:zt),3])#
		z=zt+1#
	}#
	V=rep(0,M)#
	for(i in 1:M)#
	{#
		V[i]=vr[ER[i,1]]#
	}#
	S=diag(V)#
	W=solve(S)#
	omega<-mp(t(C)%*%W%*%C)%*%t(C)%*%W%*%y#
	ytopi=C%*%omega#
	cat("omega:\n")#
	print(omega)#
	Asemi=C%*%mp(t(C)%*%W%*%C)%*%t(C)%*%W#
	MSE<-(t(y-ytopi)%*%(y-ytopi))/(M)#
	GCV<-MSE/((1/M)%*%(sum(diag(1-Asemi))))^2#
	JKT<-t(y-(mean(y)))%*%(y-(mean(y)))#
	JKG<-t(y-ytopi)%*%(y-ytopi)#
	RK<-1-(JKG/JKT)#
	cat("\n===========================================\n")#
	cat("    MSE\t\t    GCV\t\t R-square\n")#
	cat("===========================================\n")#
	cat(MSE,"\t",GCV,"\t",RK,"\n\n")#
	alfa<-as.numeric(readline("input nilai alfa yang diinginkan : "))#
	error=y-ytopi#
	#UJI NORMALITAS#
	cat("==============\n UJI ASUMSI NORMALITAS ERROR\n=============\n")#
	library(nortest)#
	un=lillie.test(error)	#
	d=as.numeric (un[2])#
	if(d<alfa)#
	{#
	cat("Keputusan	: Data tidak normal karena p-value	=",d,"<",alfa,"\n\n")#
	}#
	else#
	{#
	cat("Keputusan	: Data normal karena p-value =",d,">",alfa,"\n\n")#
	}#
#===========================SELANGKEPERCAYAAN======================#	sigmatopi=(t(y-ytopi)%*%(y-ytopi))/(M-(2+p+k))#
	ss=C%*%mp(t(C)%*%W%*%C)%*%t(C)#
	Sij=sqrt(sigmatopi*diag(ss))#
	yupper=ytopi+(qt(1-alfa/2,M-(2+p+k))*Sij)#
	ylower=ytopi-(qt(1-alfa/2,M-(2+p+k))*Sij)#
	data=data[order(data[,1],decreasing=FALSE),]#
	x=data[,1]#
	a=0#
	for(i in 1:M)#
	{#
	if(x[i]==0)#
	a=a+1#
	}#
	datace=data[1:a,]#
	dataco=data[a+1:M,]#
	dataco=dataco[1:(M-a),]#
	tbtopi=ytopi[1:M]#
	tbl=dataco[,3]#
	tbltopi=tbtopi[1:119]#
	cat("===================================================\n")#
	cat("\t  Estimasi Balita Laki-laki\n")#
	cat("===================================================\n")#
	yytopil<-sort(unique(tbltopi))#
	yupperl=yupper[1:119]#
	ylowerl=ylower[1:119]#
	lowerl<-sort(unique(ylowerl))#
	upperl<-sort(unique(yupperl))#
	cat("Usia \t Tinggi Badan \t Batas Bawah\t Batas Atas\n")#
	for(G in 0:24)		#
{#
	cat(" ",G,"\t",yytopil[G+1],"\t",lowerl[G+1],"\t",upperl[G+1],"\n")#
	}#
	pdco=length(dataco[,3])#
	sml=0#
	skl=0#
	for(i in 1:pdco)#
		{		#
		if(ylowerl[i]<=dataco[i,3]&&dataco[i,3]<=yupperl[i])sml=sml+		else skl=skl+1#
		}#
	cpl=(sml/pdco)*100#
	cat("Jumlah pengamatan di dalam selang\t:",sml,"\n")#
	cat("Jumlah pengamatan di luar selang\t:",skl,"\n")#
	cat("Coverage Probability (CP)\t\t:",cpl,"%\n\n\n\n")#
	tbp=datace[,3]#
	tbptopi=tbtopi[120:252]#
	cat("===================================================\n")#
	cat("\t  Estimasi Balita Perempuan\n")#
	cat("===================================================\n")#
	yupperp=yupper[120:252]#
	ylowerp=ylower[120:252]#
	yytopip<-sort(unique(tbptopi))#
	lowerp<-sort(unique(ylowerp))#
	upperp<-sort(unique(yupperp))#
	cat("Usia \t Tinggi Badan \t Batas Bawah\t Batas Atas\n")#
	for(F in 0:24)#
	{		#
cat(" ",F," \t",yytopip[F+1],"\t",lowerp[F+1],"\t",upperp[F+1],"\n")#
	}#
	pdce=length(datace[,3])#
	smp=0#
	skp=0#
	for(i in 1:pdce)#
		{		#
		if(ylowerp[i]<=datace[i,3]&&datace[i,3]<=yupperp[i])smp=smp+1#
			else skp=skp+1#
		}#
	cpp=(smp/pdce)*100#
	cat("Jumlah pengamatan di dalam selang\t:",smp,"\n")#
	cat("Jumlah pengamatan di luar selang\t:",skp,"\n")#
	cat("Coverage Probability (CP)\t\t:",cpp,"%\n")#
	tp=datace[,2]#
	stp=sort(tp)#
	stbp=tbp[order(tp)]#
	stbptopi<-tbptopi[order(tp)]#
	syupperp=yupperp[order(tp)]#
	sylowerp=ylowerp[order(tp)]#
	win.graph()#
	plot(stp,stbp,xlab="Usia",ylab="tinggi badan")#
	lines(stp,stbptopi,type="l",col="blue",lwd=3)#
	lines(stp,syupperp,type="l",col="black",lwd=2)#
	lines(stp,sylowerp,type="l",col="black",lwd=2)#
	title(main="PLOT USIA TERHADAP TINGGI BADAN BALITA PEREMPUAN ")	#
	par(new=TRUE)#
	tl=dataco[,2]#
	stl=sort(tl)#
	stbl=tbl[order(tl)]#
	stbltopi<-tbltopi[order(tl)]#
	syupperl=yupperl[order(tl)]#
	sylowerl=ylowerl[order(tl)]#
	win.graph()#
	plot(stl,stbl,xlab="Usia",ylab="tinggi badan")#
	lines(stl,stbltopi,type="l",col="red ",lwd=3)#
	lines(stl,syupperl,type="l",col="black",lwd=2)#
	lines(stl,sylowerl,type="l",col="black",lwd=2)#
	title(main="PLOT USIA TERHADAP TINGGI BADAN BALITA LAKI-LAKI ")	#
}#
selangkepercayaan(Dataset)
mp<- function(x,eps=1e-006)#
{#
	x<-as.matrix(x)#
	xsvd<-svd(x)#
	diago<-xsvd$d[xsvd$d>eps]#
	if(length(diago)==1)#
	{#
	xplus<-as.matrix(xsvd$v[,1])%*%t(as.matrix(xsvd$u[,1])/diago)#
	}#
	else#
	{#
xplus<-xsvd$v[,1:length(diago)]%*%diag(1/diago)%*%t(xsvd$u[,1:length(diago)])	#
	}#
	return(xplus)#
}
trun<-function(prediktor,knot,orde)#
{#
	prediktor[prediktor<knot]<-knot#
	b<-(prediktor-knot)^orde#
	return(b)#
}
selangkepercayaan<-function(data)#
{#
cat("\t    PROGRAM SELANG KEPERCAYAAN KURVA REGRESI SEMIPARAMETRIK\n\t BERDASARKAN ESTIMATOR SPLINE TRUNCATED PADA DATA LONGITUDINAL\n")#
cat("**********************************************************************************\n")
x<-data[,1]#
	t<-data[,2]#
	y<-data[,3]#
	M<-length(y)#
	p<-as.numeric(readline("Input orde : "))#
	k<-as.numeric(readline("Input jumlah knot optimum : "))
w<-rep(0,k)#
	for(i in 1:k)#
	{#
		cat("Input titik knot optimum  ke-",i)#
		w[i]<-as.numeric(readline(" = "))#
	}#
	#MENGHITUNG JUMLAH SUBJEK#
	n=0#
	for(i in 1:M)#
	{#
		if(data[i,2]==0)#
		{#
			i=1#
			n=n+i#
		}#
	}#
	cat("Jumlah Subjek : ",n,"\n")#
	#MENGHITUNG JUMLAH PENGAMATAN SETIAP SUBYEK#
	sp<-rep(0,(n+1))#
	sp[1]<-0#
	jp<-rep(0,n)#
	for(i in 2:n)#
	{#
		s<-sp[i-1]+1#
		repeat#
		{#
			s<-s+1#
			if(t[s]<t[s-1])break#
			g<-s#
		}#
		sp[i]<-g#
		jp[i-1]<-sp[i]-sp[i-1]#
	}#
	jp[n]<-M-sum(jp[1:(n-1)])#
	cat("=================================\nsubjek ke-\tjumlah pengamatan\n=================================\n")
for( i in 1:n)#
	cat(i,"\t\t", jp[i],"\n")#
	v1<-matrix(0,M,p)#
	for(i in 1:p)#
		{	#
			v1[,i]<-t^(i)#
		}#
	v2<-matrix(0,M,k)#
	for(j in 1:k)#
		{#
			v2[,j]<-trun(t,w[j],p)#
		}#
	T=cbind(v1,v2)#
	x1=rep(1,M)#
	X=cbind(x1,x)#
	C=cbind(X,T)#
	ER<-matrix(0,M,1)#
	c<-rep(0,(M+1))#
	c[1]<-0#
	for(i in 1:n)#
	{#
		c[i+1]<-sum(jp[1:i])#
		ER[(c[i]+1):c[i+1],1]<-rep(i,jp[i])#
	}#
	vr=rep(0,n)#
	z=1#
	for(i in 1:n)#
	{	#
		zt=z+jp[i]-1#
		vr[i]=var(data[(z:zt),3])#
		z=zt+1#
	}#
	V=rep(0,M)#
	for(i in 1:M)#
	{#
		V[i]=vr[ER[i,1]]#
	}#
	S=diag(V)#
	W=solve(S)#
	omega<-mp(t(C)%*%W%*%C)%*%t(C)%*%W%*%y#
	ytopi=C%*%omega#
	cat("omega:\n")#
	print(omega)
Asemi=C%*%mp(t(C)%*%W%*%C)%*%t(C)%*%W#
	MSE<-(t(y-ytopi)%*%(y-ytopi))/(M)#
	GCV<-MSE/((1/M)%*%(sum(diag(1-Asemi))))^2#
	JKT<-t(y-(mean(y)))%*%(y-(mean(y)))#
	JKG<-t(y-ytopi)%*%(y-ytopi)#
	RK<-1-(JKG/JKT)#
	cat("\n===========================================\n")#
	cat("    MSE\t\t    GCV\t\t R-square\n")#
	cat("===========================================\n")#
	cat(MSE,"\t",GCV,"\t",RK,"\n\n")#
	alfa<-as.numeric(readline("input nilai alfa yang diinginkan : "))#
	error=y-ytopi#
	#UJI NORMALITAS#
	cat("==============\n UJI ASUMSI NORMALITAS ERROR\n=============\n")#
	library(nortest)#
	un=lillie.test(error)	#
	d=as.numeric (un[2])#
	if(d<alfa)#
	{#
	cat("Keputusan	: Data tidak normal karena p-value	=",d,"<",alfa,"\n\n")#
	}#
	else#
	{#
	cat("Keputusan	: Data normal karena p-value =",d,">",alfa,"\n\n")#
	}#
#===========================SELANGKEPERCAYAAN======================#	sigmatopi=(t(y-ytopi)%*%(y-ytopi))/(M-(2+p+k))#
	ss=C%*%mp(t(C)%*%W%*%C)%*%t(C)#
	Sij=sqrt(sigmatopi*diag(ss))#
	yupper=ytopi+(qt(1-alfa/2,M-(2+p+k))*Sij)#
	ylower=ytopi-(qt(1-alfa/2,M-(2+p+k))*Sij)#
	data=data[order(data[,1],decreasing=FALSE),]#
	x=data[,1]#
	a=0#
	for(i in 1:M)#
	{#
	if(x[i]==0)#
	a=a+1#
	}#
	datace=data[1:a,]#
	dataco=data[a+1:M,]#
	dataco=dataco[1:(M-a),]#
	tbtopi=ytopi[1:M]#
	tbl=dataco[,3]#
	tbltopi=tbtopi[1:119]#
	cat("===================================================\n")
cat("\t  Estimasi Balita Laki-laki\n")#
	cat("===================================================\n")#
	yytopil<-sort(unique(tbltopi))#
	yupperl=yupper[1:119]#
	ylowerl=ylower[1:119]#
	lowerl<-sort(unique(ylowerl))#
	upperl<-sort(unique(yupperl))#
	cat("Usia \t Tinggi Badan \t Batas Bawah\t Batas Atas\n")#
	for(G in 0:24)		#
{#
	cat(" ",G,"\t",yytopil[G+1],"\t",lowerl[G+1],"\t",upperl[G+1],"\n")#
	}#
	pdco=length(dataco[,3])#
	sml=0#
	skl=0#
	for(i in 1:pdco)#
		{		#
		if(ylowerl[i]<=dataco[i,3]&&dataco[i,3]<=yupperl[i])sml=sml+		else skl=skl+1#
		}#
	cpl=(sml/pdco)*100#
	cat("Jumlah pengamatan di dalam selang\t:",sml,"\n")#
	cat("Jumlah pengamatan di luar selang\t:",skl,"\n")#
	cat("Coverage Probability (CP)\t\t:",cpl,"%\n\n\n\n")#
	tbp=datace[,3]#
	tbptopi=tbtopi[120:252]#
	cat("===================================================\n")#
	cat("\t  Estimasi Balita Perempuan\n")#
	cat("===================================================\n")
y=(9.1 10.6 12 15.3 17.5 17.2)
y=(9,1 10,6 12 15,3 17,5 17,2)
y=(9.1,10.6,12,15.3,17.5,17.2)
