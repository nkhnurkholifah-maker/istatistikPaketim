df=read_excel("/Users/nurkholifah/Downloads/final.xlsx")#
cor=cor(df)#
round(cor, 4)#
cor_Q=cor[, "Q"]#
cor_Q=cor_Q[names(cor_Q) != "Q"]#
sort(cor_Q, decreasing = TRUE)#
#
cov=cov(df)#
Ln=log(df)#
cor_Ln=cor(Ln)#
model_full <- lm(Q ~ X1 + X2 + X3 + X4 + X5 + X6 + X7 + X8 + X9, data = Ln)#
